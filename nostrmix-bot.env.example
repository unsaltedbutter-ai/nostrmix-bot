# nostrmix-bot configuration — copy to `nostrmix-bot.env` and edit.
#
#   cp nostrmix-bot.env.example nostrmix-bot.env
#
# Every key below is read by src/config.py (the loader's _DEFAULTS table).
# Omitting a key falls back to the default shown here. Values are strings,
# whitespace-trimmed, and coerced to int/float where the default is numeric.
# See README.md for the full reference (legal ranges + what each influences).
#
# SECURITY: this file holds the bot's nsec (and, if used, your BTCPay key).
# The real `nostrmix-bot.env` is git-ignored — never commit it; rotate leaks.

# ── Bot identity ─────────────────────────────────────────────────────────
# REQUIRED. The bot's Nostr SECRET key (nsec). The `_NPUB` suffix is a
# misnomer — this is the private key, passed to the SDK as `nsec`.
NOSTR_PRIVATE_KEY_NPUB=
NOSTR_RELAYS=wss://relay.damus.com,wss://nos.lol
BOT_NAME=butterbot
BOT_ABOUT=I help bitcoiners mix their coins trustlessly over Nostr.
BOT_LUD16=
BOT_PICTURE=
BOT_NIP05=
BOT_WEBSITE=

# ── Zap receiving (only needed if FEE_PER_ELEMENT > 0) ───────────────────
# The zap provider's Nostr pubkey (hex), used to validate zap receipts.
ZAP_PROVIDER_PUBKEY_HEX=

# ── Refunds via BTCPay (only needed if FEE_PER_ELEMENT > 0) ──────────────
BTCPAY_URL=
BTCPAY_STORE=
BTCPAY_API_KEY=

# ── Fees ─────────────────────────────────────────────────────────────────
# Service-fee zap per NON-conforming element (input + used output), in sats.
# 0 = no zap requested (service fee off; conforming UTXOs are always free).
FEE_PER_ELEMENT=0
FEE_MULTIPLIER=1.5            # safety multiplier on the estimated sat/vB rate
MIN_FEE_RATE_SATS=1.5         # fee-rate floor + sum-invariant floor
MAX_FEE_RATE_SATS=510        # fee-rate ceiling; 0 = no ceiling
FEE_LOOKBACK_BLOCKS=6        # recent blocks the fee estimator inspects (>=1)
REFUND_KEEP_PERCENT=5        # % of a paid fee kept on refund (0–100)
REFUND_KEEP_MIN_SATS=50      # min sats kept on refund

# ── Mix parameters ───────────────────────────────────────────────────────
DEFAULT_OUTPUT_SIZE=1000000  # equal-output size (sats); must be >= MINIMUM_UTXO_SIZE
MAX_PARTICIPANTS_DEFAULT=20  # upper bound for the auto-mix capacity check
MAX_PENDING_MIXES=5          # max simultaneous PAID mixes per npub
SIGNING_DEADLINE_HOURS=48    # window to return a signed PSBT (reminders at 1/8,1/4,1/2)
PAY_DEADLINE_HOURS=12        # window to pay; also the collecting/ghost-recovery deadline
MAX_GHOST_RETRIES=3          # collecting restarts after a ghost before cancel+refund
MINIMUM_UTXO_SIZE=10000      # dust threshold; smaller UTXOs rejected at /commit

# ── Conforming / non-conforming model ────────────────────────────────────
DEFAULT_REQUIRED_NONCONFORMING=3            # exact # of non-conforming participants a new mix waits for
MAX_CONFORMING_UTXOS=10                      # max conforming UTXOs a mix absorbs (fee assumes this many)
MAX_NONCONFORMING_UTXOS_PER_PARTICIPANT=10   # per-participant cap on non-conforming UTXOs
# Static address for donated above-dust change when a non-conforming
# participant gives no change address. RECOMMENDED: leave BLANK — a recurring
# operator address is a linkable on-chain fingerprint across coinjoins. Blank
# folds such leftovers into the miner fee (most private). Only set this if you
# accept the privacy cost of keeping those sats.
DONATION_ADDRESS=

# ── Scheduling & broadcast ───────────────────────────────────────────────
ANNOUNCEMENT_HOUR_UTC=14            # UTC hour (0–23) the daily mix announcement posts
BROADCAST_CHECK_INTERVAL_HOURS=24   # how often broadcast txs are re-checked/re-pushed

# ── Script-type allowlist (comma-separated; empty -> p2wpkh) ─────────────
ACCEPTED_INPUT_TYPES=p2wpkh
ACCEPTED_OUTPUT_TYPES=p2wpkh

# ── Bitcoin API ──────────────────────────────────────────────────────────
MEMPOOL_API=https://mempool.space/api
MEMPOOL_API_BACKUP=https://blockstream.info/api   # blank to disable fallback

# ── Database ─────────────────────────────────────────────────────────────
DB_PATH=./bot.db

# ── Per-script-type vbyte sizes (advanced; rarely changed) ───────────────
P2PKH_INPUT_VSIZE=150
P2SH_INPUT_VSIZE=135
P2SH_P2WPKH_INPUT_VSIZE=95
P2WPKH_INPUT_VSIZE=70
P2WSH_INPUT_VSIZE=100
P2TR_INPUT_VSIZE=60
P2PKH_OUTPUT_VSIZE=35
P2SH_OUTPUT_VSIZE=35
P2SH_P2WPKH_OUTPUT_VSIZE=35
P2WPKH_OUTPUT_VSIZE=35
P2WSH_OUTPUT_VSIZE=45
P2TR_OUTPUT_VSIZE=45
TX_OVERHEAD_VSIZE=10
